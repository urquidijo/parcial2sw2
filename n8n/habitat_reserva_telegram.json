{
  "name": "Habitat Pro - CU14 Confirmación de reserva por Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "habitat-reserva-confirmada",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "cu14-webhook",
      "name": "Reserva confirmada (gateway)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "habitat-reserva-confirmada",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Habitat Gateway Secret"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ Reserva confirmada — Habitat Pro\n\n🏠 {{ $json.body.propertyTitle || $json.body.propertyId }}\n👤 {{ $json.body.userName }}\n💵 Arras: {{ $json.body.depositAmount }} USD\n🧾 Reserva {{ $json.body.reservationId }} · Pre-contrato {{ $json.body.contractNumber }}\n⏱️ Vence: {{ new Date($json.body.expiresAt).toLocaleString('es-BO', { timeZone: 'America/La_Paz' }) }}\n\nSiguiente paso: el Oficial Legal preparará el contrato definitivo para tu firma.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "cu14-telegram",
      "name": "Enviar confirmación por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, 300],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Habitat Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Reserva confirmada (gateway)": {
      "main": [
        [
          {
            "node": "Enviar confirmación por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/La_Paz"
  }
}
