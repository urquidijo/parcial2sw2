# Variables para Google Cloud Run. Copiar a env.yaml (no se versiona) y usar:
#   gcloud run deploy ms-properties --source . --region us-central1 --allow-unauthenticated --port 3001 --env-vars-file env.yaml
# Las comillas evitan que los & y las comas de la cadena de Atlas rompan el comando.
MONGO_URI: "mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/properties_catalog_db?retryWrites=true&w=majority"
KEYCLOAK_ISSUER_URI: "https://CAMBIAR-keycloak.up.railway.app/realms/habitat"
