{
  "realm": "habitat",
  "enabled": true,
  "displayName": "Habitat Pro",
  "loginTheme": "habitat",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "en"
  ],
  "defaultLocale": "es",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "CLIENTE",
        "description": "Cliente: catálogo, visitas, reservas y firma de contratos"
      },
      {
        "name": "EMPLEADO",
        "description": "Empleado de la inmobiliaria; su área se indica en el atributo sector"
      },
      {
        "name": "ADMIN",
        "description": "Administrador general"
      },
      {
        "name": "default-roles-habitat",
        "description": "Roles por defecto (auto-registro = CLIENTE)",
        "composite": true,
        "composites": {
          "realm": [
            "CLIENTE"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-habitat",
    "composite": true
  },
  "clients": [
    {
      "clientId": "habitat-web",
      "name": "Habitat Pro Web (shell, ERP, BI, PWA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*",
        "http://localhost:3003/*",
        "https://parcial2sw2-mfe-shell.vercel.app/*",
        "https://parcial2sw2.vercel.app/*",
        "https://api-gateway-production-c3ed.up.railway.app/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "sector",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "sector",
            "claim.name": "sector",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "habitat-admin-api",
      "name": "ms-contracts: gestión de empleados (CU08)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "habitat-monitor",
      "name": "Agente monitor del negocio (CU21)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_MONITOR_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-habitat-admin-api",
      "enabled": true,
      "serviceAccountClientId": "habitat-admin-api",
      "clientRoles": {
        "realm-management": [
