{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "mfe-contracts": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "erp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": [],
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1.5MB" }]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "mfe-contracts:build:production" },
            "development": { "buildTarget": "mfe-contracts:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
