# ==============================================================================
# HABITAT PRO - VARIABLES DE ENTORNO (PLANTILLA EJEMPLO)
# Copia este archivo a .env para tu configuración local
# ==============================================================================

# Servidor Backend API Gateway
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=super_secret_proptech_enterprise_jwt_key_2026

# Base de Datos Relacional: PostgreSQL (Docker host port 5435)
POSTGRES_URI=postgres://proptech_admin:admin_secure_password@localhost:5435/contracts_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=contracts_db
POSTGRES_USER=proptech_admin
POSTGRES_PASSWORD=admin_secure_password

# Base de Datos Documental: MongoDB (Docker host port 27017)
MONGO_URI=mongodb://proptech_admin:admin_secure_password@localhost:27017/properties_catalog_db?authSource=admin
MONGO_INITDB_DATABASE=properties_catalog_db

# Base de Datos Clave-Valor: DynamoDB Local (Docker host port 8005)
DYNAMODB_ENDPOINT=http://localhost:8005
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy_key_proptech
AWS_SECRET_ACCESS_KEY=dummy_secret_proptech

# Identity & Access Management (SSO): Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=proptech-enterprise
KEYCLOAK_CLIENT_ID=mfe-shell-client

# Microservicios Adicionales
MS_PROPERTIES_URL=http://localhost:3001
MS_CONTRACTS_URL=http://localhost:8081
MS_BILLING_URL=http://localhost:8002

# Inteligencia Artificial Generativa (Anthropic Claude API)
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
