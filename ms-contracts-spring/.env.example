PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario>
SPRING_DATASOURCE_PASSWORD=<password>
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/habitat
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/habitat/protocol/openid-connect/certs
KEYCLOAK_ADMIN_CLIENT_SECRET=<mismo valor que el secret del cliente habitat-admin-api en Keycloak>
